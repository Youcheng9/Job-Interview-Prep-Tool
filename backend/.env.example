# Database
DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/interviewprep

# JWT
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
PASSWORD_RESET_URL_BASE=http://localhost:5173/auth?mode=reset

# Optional SMTP for password reset emails
EMAIL_FROM=no-reply@interviewprep.local
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# Free local LLM via Ollama
OLLAMA_URL=http://127.0.0.1:11434/api/generate
# OLLAMA_MODEL=llama3.1:8b
OLLAMA_MODEL=llama3.2:3b
AI_FEEDBACK_MODEL=llama3.2:3b
AI_CHAT_MODEL=qwen2.5:7b-instruct

# Agentic coaching feedback
AI_FEEDBACK_ENABLED=true
# AI_FEEDBACK_TIMEOUT_SECONDS=90
AI_FEEDBACK_TIMEOUT_SECONDS=60
AI_FEEDBACK_FAST_MODE=true
# AI_FEEDBACK_MAX_TOKENS=220
AI_FEEDBACK_MAX_TOKENS=80
AI_FEEDBACK_NUM_CTX=768
AI_FEEDBACK_MAX_RETRIES=1
AI_FEEDBACK_RETRY_WITH_PLAIN_JSON=true
AI_FEEDBACK_PROMPT_ANSWER_CHARS=450
AI_FEEDBACK_PROMPT_IDEAL_CHARS=180

# Chat-specific AI tuning
AI_FEEDBACK_CHAT_MAX_TOKENS=120
AI_CHAT_NUM_CTX=768
AI_CHAT_PROMPT_ANSWER_CHARS=420
AI_CHAT_PROMPT_HISTORY_CHARS=180
